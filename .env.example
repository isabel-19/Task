# Copiar a backend/.env. No añadir credenciales al repositorio.
APP_ENV=development
DATABASE_URL=sqlite:///./roadmap-demo.db
# Para Supabase: postgresql+psycopg://usuario:clave@host:5432/postgres?sslmode=require
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
DEMO_MODE=true
SESSION_HOURS=8
IMPORTS_ENABLED=true
# Archivos de evidencia: directorio privado persistente; vacío usa backend/storage/evidence.
EVIDENCE_UPLOADS_ENABLED=true
EVIDENCE_STORAGE_DIR=
# En Render Free: supabase; bucket privado y clave secreta solo en el servidor.
EVIDENCE_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=roadmap-evidence
SUPABASE_SERVICE_KEY=
EVIDENCE_MAX_UPLOAD_MB=20
# En el contenedor se configura automáticamente; vacío mantiene Vite separado en desarrollo.
FRONTEND_DIST=
# Cuentas vinculadas: registrar aplicaciones web OAuth en Google Cloud / Microsoft Entra.
# Generar CLOUD_TOKEN_KEY mediante scripts/setup-cloud-local.py; conservarla fuera de Git.
CLOUD_TOKEN_KEY=
CLOUD_PUBLIC_API_URL=http://127.0.0.1:5173/api
CLOUD_FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Contraseña de instalación: definir localmente antes de seed; no hay contraseña predeterminada.
DEMO_PASSWORD=
VITE_API_URL=http://127.0.0.1:8000/api
